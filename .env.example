# ==============================================================================
# VANGUARD GYM OS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your production credentials.
# NEVER commit your real .env file with live secrets to GitHub.
# ==============================================================================

# Flask Session & CSRF Secret Key (Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AND_SET_IT_IN_HOSTING_SETTINGS

# Application Environment (development | production)
APP_ENV=production
FLASK_ENV=production

# Supabase / PostgreSQL Database Connection URL
# Direct Connection format:
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Session Pooler format (recommended for PythonAnywhere free tier):
# postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres

# Supabase REST API Configuration (Optional: for PythonAnywhere free tier outbound HTTPS)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Gym Local Timezone (Standard IANA identifier)
GYM_TIMEZONE=Asia/Karachi

# Local Development / Testing Database URL (Defaults to local PostgreSQL if left blank)
# TEST_DATABASE_URL=postgresql://gym_user:gym_secure_pass_2026@127.0.0.1:5432/gym_portal
